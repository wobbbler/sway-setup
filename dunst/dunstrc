[global]
    ### Display & Position ###
    monitor = 0
    follow = none
    origin = top-right
    offset = (20, 60)
    notification_limit = 8

    ### Geometry & Gaps ###
    width = 500
    height = (0, 200)
    gap_size = 6
    corner_radius = 6
    corners = all

    ### Progress Bar (Volume/Brightness) ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 3
    progress_bar_corners = all

    ### Borders & Padding ###
    frame_width = 1
    frame_color = "#3a3a3a"
    separator_height = 2
    separator_color = frame
    
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10

    ### Text & Fonts ###
    font = JetBrains Mono, Monospace 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 4
    icon_corners = all

    ### Behavior & Mouse ###
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    history_length = 20
    sticky_history = yes
    ignore_dbusclose = false
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    ### Integrations ###
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true

# ==========================================
# URGENCY STYLES (MONOCHROME/GREY THEME)
# ==========================================

[urgency_low]
    background = "#1a1a1a"
    foreground = "#7a7a7a"
    frame_color = "#2d2d2d"
    timeout = 6
    default_icon = dialog-information

[urgency_normal]
    background = "#1e1e1e"
    foreground = "#dedede"
    frame_color = "#3a3a3a"
    timeout = 8
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#1e1e1e"
    foreground = "#ff8787"
    frame_color = "#e05f65"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning

# ==========================================
# FULLSCREEN RULES
# ==========================================

[fullscreen_delay_everything]
    fullscreen = delay

[fullscreen_show_critical]
    msg_urgency = critical
    fullscreen = show
